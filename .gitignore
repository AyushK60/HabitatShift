# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- Node ----
node_modules/
frontend/dist/
frontend/.vite/

# ---- Large satellite data (raw windows, GeoTIFF analysis rasters) ----
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
# Keep the small measured summary the proof viewer serves; rasters stay local.
!data/processed/*/
!data/processed/*/summary.json
# M1 keeps its small machine-readable outputs; the GeoTIFF rasters and the
# observation cache stay local.  Rendered previews are tracked below
# data/previews/m1/ so the viewer works from a clean clone.
!data/processed/m1/*/
!data/processed/m1/*/summary.json
!data/processed/m1/*/summary.csv
!data/processed/m1/*/status.json
data/cache/**
!data/cache/.gitkeep

# ---- Secrets (never commit credentials) ----
.env
.env.*
!.env.example

# ---- OS / editor ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ---- Local scratch ----
*.log
!docs/evidence/m0/*.log
tmp/

# ---- Frontend build output (rebuild with: cd frontend && npm run build) ----
frontend/dist/

# ---- One-click startup runtime state (start.bat / stop.bat) ----
.runtime/

# Custom-area run outputs (generated, bounded, pruned automatically)
data/custom_runs/

# Local design-tool state
.impeccable/

# Lake pipeline: DEM/slope arrays are regenerated on demand
data/lakes/**/*.npz

# Third-party reference datasets are downloaded on demand, not committed
data/reference/

# Downloaded model weights
data/models/

# Phase 3 training tiles are regenerated by scripts/build_lake_training_pairs.py
data/lakes_train/**/*.npz
